<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion><UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>FoliaLyrics</AssemblyName><Product>folia-Lyrics</Product><Version>0.4.26</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon><PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><DebugType>none</DebugType><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31"/>
    <PackageReference Include="NAudio" Version="2.2.1"/><PackageReference Include="TagLibSharp" Version="2.3.0"/>
    <EmbeddedResource Include="web-assets.zip"/>
    <EmbeddedResource Include="web-assets.sha256"/>
  </ItemGroup>
  <Target Name="RemoveUnusedWpfWebView" BeforeTargets="ResolveAssemblyReferences"><ItemGroup>
    <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Reference.Identity)').EndsWith('Microsoft.Web.WebView2.Wpf.dll'))"/>
  </ItemGroup></Target>
  <Target Name="HashDesktopAssets" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="$(MSBuildProjectDirectory)/web-assets.zip" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="DesktopAssetHash"/>
    </GetFileHash>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/web-assets.sha256" Lines="@(DesktopAssetHash->'%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true"/>
  </Target>
</Project>
