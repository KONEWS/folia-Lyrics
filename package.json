{
  "name": "folia-lyrics",
  "productName": "folia-Lyrics",
  "description": "Standalone Windows desktop lyrics with local visualizers and online lyric matching",
  "author": {
    "name": "chthollyphile",
    "email": "chthollyphile@users.noreply.github.com"
  },
  "private": true,
  "version": "0.5.6",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.desktop.config.ts --open /desktop.html",
    "build": "npm run build:desktop",
    "preview": "vite preview --config vite.desktop.config.ts --open /desktop.html",
    "typecheck": "tsc --noEmit",
    "codemap": "node dev/mcp/ts-code-map/codemap.mjs",
    "codemap:check": "node dev/mcp/ts-code-map/codemap.mjs --check",
    "test": "npm run test:unit",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:unit:watch": "vitest -c vitest.config.ts",
    "models:fetch": "node build/fetchModels.mjs",
    "build:desktop": "node build/fetchModels.mjs && vite build --config vite.desktop.config.ts",
    "typecheck:desktop": "tsc -p tsconfig.desktop.json --noEmit",
    "test:desktop": "vitest run -c vitest.desktop.config.ts",
    "check:desktop-version": "node tools/check-desktop-version.mjs",
    "test:desktop:ui": "node test/verify-renderers.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@chenglou/pretext": "^0.0.9",
    "@paper-design/shaders": "0.0.80",
    "@paper-design/shaders-react": "^0.0.80",
    "@react-three/fiber": "^9.8.1",
    "@xmldom/xmldom": "^0.9.12",
    "blueimp-md5": "^2.19.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "framer-motion": "^13.4.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.48.0",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-window": "^2.3.3",
    "three": "^0.185.1",
    "twgl.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "0.1.74",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "24.1.3",
    "opencc-js": "^1.4.2",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
