<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile the production launch hold and window adapter with an in-memory clock and harmless window controls. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Windows.Forms"/>
    <Compile Include="../../native/WindowForegroundProtection.cs" Link="WindowForegroundProtection.cs"/>
    <Compile Include="../../native/WindowLaunchForeground.cs" Link="WindowLaunchForeground.cs"/>
    <Compile Include="../../native/WindowMusicAppLaunch.cs" Link="WindowMusicAppLaunch.cs"/>
  </ItemGroup>
</Project>
