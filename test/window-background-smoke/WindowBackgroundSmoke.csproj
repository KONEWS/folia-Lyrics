<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the real native/WindowBackgroundState.cs against stand-ins for the form, timer and WebView2 control. Plain net10.0: it needs no Windows, no WebView2 and opens no window or audio device. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Windows.Forms"/>
    <Compile Include="../../native/WindowBackgroundState.cs" Link="WindowBackgroundState.cs"/>
    <Compile Include="../../native/WindowBackgroundPolicy.cs" Link="WindowBackgroundPolicy.cs"/>
    <Compile Include="../../native/Preferences.cs" Link="Preferences.cs"/>
  </ItemGroup>
</Project>
